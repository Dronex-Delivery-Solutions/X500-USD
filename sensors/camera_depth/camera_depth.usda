#usda 1.0
(
    "X500 + forward-facing OAK-D Lite RGB/depth camera. Generated by sensors/camera_depth/build.py from PX4/PX4-gazebo-models (BSD-3-Clause). Edit the script, not this file."
    defaultPrim = "x500"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "x500" (
    prepend references = @../../x500/x500.usda@
)
{
    def Xform "camera_depth_housing" (
        instanceable = true
        prepend references = @./geometries.usdc@</Geometries/oakd_housing>
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.12, 0.03, 0.242)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "body"
    {
        def Scope "cameras" (
            doc = "OAK-D Lite RGB + depth cameras, forward-facing. Not a separate rigid body (mounted rigidly on /x500/body, same frame) - capture them with isaacsim.sensors.experimental.rtx, not Pegasus's MonocularCamera; see sensors/README.md."
        )
        {
            def Camera "rgb" (
                prepend apiSchemas = ["OmniSensorAPI"]
            )
            {
                float2 clippingRange = (0.1, 100)
                float focalLength = 0.015249385
                float horizontalAperture = 0.020955
                custom string omni:sensor:marketName = "OAK-D Lite"
                custom string omni:sensor:modelName = "IMX214"
                custom string omni:sensor:modelVendor = "Luxonis"
                custom float omni:sensor:tickRate = 30
                float verticalAperture = 0.011787187
                quatd xformOp:orient = (-0.5000000000000002, -0.5, 0.5, 0.5)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0.13233, 0, 0.26078)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Camera "depth" (
                prepend apiSchemas = ["OmniSensorAPI"]
            )
            {
                float2 clippingRange = (0.2, 19.1)
                float focalLength = 0.014160867
                float horizontalAperture = 0.020955
                custom string omni:sensor:marketName = "OAK-D Lite"
                custom string omni:sensor:modelName = "StereoOV7251"
                custom string omni:sensor:modelVendor = "Luxonis"
                custom float omni:sensor:tickRate = 30
                float verticalAperture = 0.01571625
                quatd xformOp:orient = (-0.5000000000000002, -0.5, 0.5, 0.5)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0.13233, 0, 0.26078)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }
    }
}

