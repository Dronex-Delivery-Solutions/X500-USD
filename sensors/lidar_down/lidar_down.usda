#usda 1.0
(
    "X500 + downward LW20 rangefinder. Generated by sensors/lidar_down/build.py from PX4/PX4-gazebo-models (BSD-3-Clause). Edit the script, not this file."
    defaultPrim = "x500"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "x500" (
    prepend references = @../../x500/x500.usda@
)
{
    def Xform "lidar_down_housing" (
        instanceable = true
        prepend references = @./geometries.usdc@</Geometries/lw20_housing>
    )
    {
        quatd xformOp:orient = (0.7073882691671998, 0, 0.706825181105366, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, -0.079)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Xform "lidar_down" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        doc = "Lightware LW20 single-beam rangefinder, aimed straight down (-Z in the body frame). PX4 consumes this as a MAVLink DISTANCE_SENSOR message - see sensors/README.md."
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.00001, 0.00001, 0.00001)
        float physics:mass = 0.001
        quatf physics:principalAxes = (1, 0, 0, 0)
        quatd xformOp:orient = (6.123233995736766e-17, 0.7073882691671997, 4.328055977987174e-17, -0.7068251811053661)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, -0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Cube "collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
            uniform token purpose = "guide"
            double size = 0.001
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def OmniLidar "sensor" (
            prepend apiSchemas = ["OmniSensorGenericLidarCoreAPI"]
        )
        {
            custom float[] omni:sensor:Core:emitterState:s001:azimuthDeg = [0]
            custom uint[] omni:sensor:Core:emitterState:s001:channelId = [1]
            custom float[] omni:sensor:Core:emitterState:s001:elevationDeg = [0]
            custom uint[] omni:sensor:Core:emitterState:s001:fireTimeNs = [0]
            custom float omni:sensor:Core:farRangeM = 100
            custom float omni:sensor:Core:nearRangeM = 0.1
            custom uint omni:sensor:Core:numberOfChannels = 1
            custom uint omni:sensor:Core:numberOfEmitters = 1
        }
    }

    over "joints"
    {
        def PhysicsFixedJoint "lidar_down_joint"
        {
            rel physics:body0 = </x500/body>
            rel physics:body1 = </x500/lidar_down>
            uniform bool physics:excludeFromArticulation = 1
            point3f physics:localPos0 = (0, 0, -0.05)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (6.123234e-17, 0.7073883, 4.328056e-17, -0.7068252)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

